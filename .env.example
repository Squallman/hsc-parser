# Secrets only. Everything else lives in config/app.yaml, which is committed.
#
# Copy to .env (gitignored) and fill in what the commands you run actually need
# — no command needs all six.
#
#   refresh-session   IDGOV_SIGNING_KEY_PATH IDGOV_SIGNING_KEY_PASSWORD
#                     HSC_MONGODB_URI HSC_SESSION_ENCRYPTION_KEY
#   init-config       HSC_MONGODB_URI HSC_SESSION_ENCRYPTION_KEY
#   monitor-once      HSC_MONGODB_URI HSC_SESSION_ENCRYPTION_KEY
#                     (+ TELEGRAM_* when notifying)
#   telegram-test     TELEGRAM_BOT_TOKEN TELEGRAM_USERS
#
# The first two are LOCAL ONLY: they authenticate to ID.GOV.UA via electronic
# signature, and GitHub Actions is never given them.

IDGOV_SIGNING_KEY_PATH=
IDGOV_SIGNING_KEY_PASSWORD=
HSC_MONGODB_URI=
HSC_SESSION_ENCRYPTION_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_USERS=
